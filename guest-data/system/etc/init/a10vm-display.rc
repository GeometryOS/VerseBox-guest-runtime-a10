service a10vm-display /system/bin/app_process -Djava.class.path=/system/framework/a10vm-bridge.jar / io.a10vm.guest.BridgeMain /dev/a10vm-display 720 1280
    class late_start
    user root
    group root graphics input
    seclabel u:r:su:s0
    disabled
    stdio_to_kmsg

on property:sys.boot_completed=1
    start a10vm-display
